// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Archos 101 Oxygen (ac101ox) tablet, RK3288.
 * Bring-up DTS derived from the stock Android 4.4 device tree.
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/media/video-interfaces.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/pwm/pwm.h>
#include "rk3288.dtsi"

/ {
	model = "Archos 101 Oxygen";
	compatible = "archos,oxygen101", "rockchip,rk3288";

	aliases {
		mmc0 = &emmc;
		mmc1 = &sdmmc;
		mmc2 = &sdio0;
	};

	chosen {
		stdout-path = "serial2:115200n8";
	};

	reserved-memory {
		ramoops@7ff00000 {
			compatible = "ramoops";
			reg = <0x0 0x7ff00000 0x0 0x100000>;
			record-size = <0x20000>;
			console-size = <0x80000>;
			pmsg-size = <0x20000>;
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x80000000>;
	};

	vcc_sys: regulator-vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-min-microvolt = <3800000>;
		regulator-max-microvolt = <3800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_5v: regulator-vcc-5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc_5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio7 RK_PB4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc_sys>;
	};

	vcc_host_5v: regulator-vcc-host-5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc_host_5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&vcc_5v>;
	};

	/* Both cameras; the stock kernel calls the enable "pwen" */
	vcc_camera: regulator-vcc-camera {
		compatible = "regulator-fixed";
		regulator-name = "vcc_camera";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&vcc_sys>;
	};

	isp: isp@ff910000 {
		compatible = "rockchip,rk3288-cif-isp";
		reg = <0x0 0xff910000 0x0 0x4000>;
		interrupts = <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru SCLK_ISP>, <&cru ACLK_ISP>, <&cru HCLK_ISP>,
			 <&cru PCLK_ISP_IN>, <&cru SCLK_ISP_JPE>;
		clock-names = "isp", "aclk", "hclk", "pclk", "jpe";
		iommus = <&isp_mmu>;
		power-domains = <&power RK3288_PD_VIO>;
		pinctrl-names = "default";
		pinctrl-0 = <&isp_dvp>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;

				/*
				 * The sensor's D9-D2 reach the ISP's D7-D0, the
				 * low lines of its 12-line bus; polarities as
				 * the stock kernel programs them.
				 */
				isp_parallel_in: endpoint {
					remote-endpoint = <&ov5640_out>;
					bus-type = <MEDIA_BUS_TYPE_PARALLEL>;
					bus-width = <12>;
					hsync-active = <1>;
					vsync-active = <0>;
					pclk-sample = <1>;
				};
			};
		};
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "Archos 101 Oxygen";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,hp-det-gpios = <&gpio7 RK_PA7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&hp_det>;
		simple-audio-card,widgets =
			"Speaker", "Speaker",
			"Headphone", "Headphones",
			"Microphone", "Internal Mic",
			"Microphone", "Headset Mic";
		simple-audio-card,routing =
			"Speaker", "SPOLP",
			"Speaker", "SPOLN",
			"Speaker", "SPORP",
			"Speaker", "SPORN",
			"Headphones", "HPOL",
			"Headphones", "HPOR",
			"IN1P", "Internal Mic",
			"IN2P", "Headset Mic",
			"Headset Mic", "MICBIAS1",
			"Internal Mic", "MICBIAS1";

		simple-audio-card,cpu {
			sound-dai = <&i2s>;
		};

		simple-audio-card,codec {
			sound-dai = <&rt5640>;
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm0 0 25000 0>;
		enable-gpios = <&gpio7 RK_PA2 GPIO_ACTIVE_HIGH>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <200>;
		power-supply = <&vcc_sys>;
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		button-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <0>;
		};

		button-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <300000>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pwr_key>;

		power-key {
			label = "Power";
			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			debounce-interval = <20>;
			wakeup-source;
		};

		lid-switch {
			label = "Hall sensor";
			gpios = <&gpio0 RK_PA6 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			wakeup-source;
		};
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio4 RK_PD4 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <50>;
	};
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk &emmc_cmd &emmc_pwr &emmc_bus8>;
	vmmc-supply = <&vccio>;
	vqmmc-supply = <&vcc_18>;
	status = "okay";
};

&sdmmc {
	bus-width = <4>;
	cap-sd-highspeed;
	broken-cd;
	card-detect-delay = <200>;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_bus4>;
	vmmc-supply = <&vcc_sd>;
	status = "okay";
};

&sdio0 {
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdio0_bus4 &sdio0_cmd &sdio0_clk>;
	vmmc-supply = <&vccio>;
	vqmmc-supply = <&vcc_wl>;
	status = "okay";

	brcmf: wifi@1 {
		compatible = "brcm,bcm4329-fmac";
		reg = <1>;
		interrupt-parent = <&gpio4>;
		interrupts = <RK_PD6 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
	};
};

&i2c0 {
	clock-frequency = <400000>;
	status = "okay";

	/* Same CPU/GPU supplies as the veyron Chromebooks, VSEL0 in use */
	vdd_cpu: regulator@40 {
		compatible = "silergy,syr827";
		reg = <0x40>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <1350000>;
		regulator-ramp-delay = <8000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc_sys>;
	};

	vdd_gpu: regulator@41 {
		compatible = "silergy,syr828";
		reg = <0x41>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_gpu";
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <1250000>;
		regulator-ramp-delay = <6000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc_sys>;
	};

	pmic: pmic@32 {
		compatible = "ricoh,rc5t619";
		reg = <0x32>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA4 IRQ_TYPE_LEVEL_LOW>;
		system-power-controller;

		regulators {
			/* All rails kept on at their stock settings for bring-up. */
			vccio: DCDC1 {
				regulator-name = "vccio";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dcdc2: DCDC2 {
				regulator-name = "ricoh_dcdc2";
				regulator-min-microvolt = <2000000>;
				regulator-max-microvolt = <2000000>;
				regulator-always-on;
				regulator-boot-on;
			};

			vcc_lcd: DCDC3 {
				regulator-name = "vcc_lcd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			vdd_logic: DCDC4 {
				regulator-name = "vdd_logic";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1500000>;
				regulator-always-on;
				regulator-boot-on;
			};

			vcc_ddr: DCDC5 {
				regulator-name = "vcc_ddr";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
				regulator-boot-on;
			};

			vccio_pmu: LDO1 {
				regulator-name = "vccio_pmu";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo2: LDO2 {
				regulator-name = "ricoh_ldo2";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo3: LDO3 {
				regulator-name = "ricoh_ldo3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			vcc_sd: LDO4 {
				regulator-name = "vcc_sd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			vcc_wl: LDO5 {
				regulator-name = "vcc_wl";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo6: LDO6 {
				regulator-name = "ricoh_ldo6";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo7: LDO7 {
				regulator-name = "ricoh_ldo7";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo8: LDO8 {
				regulator-name = "ricoh_ldo8";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo9: LDO9 {
				regulator-name = "ricoh_ldo9";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-always-on;
				regulator-boot-on;
			};

			vcc_18: LDO10 {
				regulator-name = "vcc_18";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldortc1: LDORTC1 {
				regulator-name = "ricoh_ldortc1";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldortc2: LDORTC2 {
				regulator-name = "ricoh_ldortc2";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

&gpu {
	mali-supply = <&vdd_gpu>;
	status = "okay";
};

&i2c1 {
	/* The stock kernel uses the internal pull-ups; the MPU-6050 needs them */
	pinctrl-0 = <&i2c1_xfer_pu>;
	status = "okay";

	magnetometer@d {
		compatible = "asahi-kasei,ak8963";
		reg = <0x0d>;
	};

	imu@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		interrupt-parent = <&gpio8>;
		interrupts = <RK_PA0 IRQ_TYPE_EDGE_RISING>;
		pinctrl-names = "default";
		pinctrl-0 = <&mpu_int>;
		/* The chip sits upside down: Y and Z point the other way */
		mount-matrix = "1",  "0",  "0",
			       "0", "-1",  "0",
			       "0",  "0", "-1";
	};
};

&i2c2 {
	pinctrl-0 = <&i2c2_xfer_pu>;
	status = "okay";

	/* Realtek RT5640, sold to Rockchip as "RT3224"/"RT3261" */
	rt5640: audio-codec@1c {
		compatible = "realtek,rt5640";
		reg = <0x1c>;
		clocks = <&cru SCLK_I2S0_OUT>;
		clock-names = "mclk";
		realtek,ldo1-en-gpios = <&gpio7 RK_PB0 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
	};
};

&i2c4 {
	status = "okay";

	touchscreen@1 {
		compatible = "vtl,ct365";
		reg = <0x01>;
		/* Exact rail unknown, one of the always-on Ricoh 3.3 V LDOs */
		vdd-supply = <&ldo8>;
		interrupt-parent = <&gpio7>;
		interrupts = <RK_PA6 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts_int>;
		reset-gpios = <&gpio7 RK_PA5 GPIO_ACTIVE_LOW>;
		touchscreen-size-x = <1920>;
		touchscreen-size-y = <1200>;
	};
};

&gpio0 {
	/*
	 * Not in the stock device tree, which calls this pin "otg_drv". The
	 * stock kernel drives it low, and the MPU-6050 doesn't answer
	 * otherwise.
	 */
	mpu-enable-hog {
		gpio-hog;
		gpios = <RK_PB4 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "mpu-enable";
	};
};

&gpio2 {
	/* Front camera (OV2659): keep it off the shared parallel bus */
	ov2659-powerdown-hog {
		gpio-hog;
		gpios = <RK_PB6 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ov2659-powerdown";
	};
};

&i2c3 {
	status = "okay";

	/* Back camera */
	camera@3c {
		compatible = "ovti,ov5640";
		reg = <0x3c>;
		clocks = <&cru SCLK_VIP_OUT>;
		clock-names = "xclk";
		assigned-clocks = <&cru SCLK_VIP_OUT>;
		assigned-clock-parents = <&xin24m>;
		assigned-clock-rates = <24000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&isp_clkout>;
		powerdown-gpios = <&gpio2 RK_PB7 GPIO_ACTIVE_HIGH>;
		AVDD-supply = <&vcc_camera>;
		DVDD-supply = <&vcc_camera>;
		DOVDD-supply = <&vcc_camera>;
		/* On the back, upright in landscape */
		orientation = <1>;
		rotation = <0>;

		port {
			/* Gives the stock POLARITY_CTRL00 value, 0x20 */
			ov5640_out: endpoint {
				remote-endpoint = <&isp_parallel_in>;
				bus-type = <MEDIA_BUS_TYPE_PARALLEL>;
				bus-width = <8>;
				data-shift = <2>;
				hsync-active = <0>;
				vsync-active = <1>;
				pclk-sample = <1>;
			};
		};
	};
};

&i2s {
	status = "okay";
};

&isp_mmu {
	status = "okay";
};

&pinctrl {
	headphone {
		hp_det: hp-det {
			rockchip,pins = <7 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	i2c1 {
		i2c1_xfer_pu: i2c1-xfer-pu {
			rockchip,pins = <8 RK_PA4 1 &pcfg_pull_up>,
					<8 RK_PA5 1 &pcfg_pull_up>;
		};
	};

	i2c2 {
		i2c2_xfer_pu: i2c2-xfer-pu {
			rockchip,pins = <6 RK_PB1 1 &pcfg_pull_up>,
					<6 RK_PB2 1 &pcfg_pull_up>;
		};
	};

	isp {
		/*
		 * D0-D7, vsync, href, pixel clock. D8-D11 stay GPIOs so the
		 * ISP reads them as 0: D8/D9 are pulled up, D10/D11 are the
		 * cameras' power-down lines.
		 */
		isp_dvp: isp-dvp {
			rockchip,pins = <2 RK_PB4 1 &pcfg_pull_none>,
					<2 RK_PB5 1 &pcfg_pull_none>,
					<2 RK_PA0 1 &pcfg_pull_none>,
					<2 RK_PA1 1 &pcfg_pull_none>,
					<2 RK_PA2 1 &pcfg_pull_none>,
					<2 RK_PA3 1 &pcfg_pull_none>,
					<2 RK_PA4 1 &pcfg_pull_none>,
					<2 RK_PA5 1 &pcfg_pull_none>,
					<2 RK_PB0 1 &pcfg_pull_none>,
					<2 RK_PB1 1 &pcfg_pull_none>,
					<2 RK_PB2 1 &pcfg_pull_none>;
		};

		isp_clkout: isp-clkout {
			rockchip,pins = <2 RK_PB3 1 &pcfg_pull_none>;
		};
	};

	imu {
		mpu_int: mpu-int {
			rockchip,pins = <8 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	keys {
		pwr_key: pwr-key {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	touchscreen {
		ts_int: ts-int {
			rockchip,pins = <7 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&pwm0 {
	status = "okay";
};

&mipi_dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel: panel@0 {
		compatible = "archos,oxygen101-panel";
		reg = <0>;
		backlight = <&backlight>;
		power-supply = <&vcc_lcd>;

		port {
			panel_in_mipi: endpoint {
				remote-endpoint = <&mipi_out_panel>;
			};
		};
	};
};

&mipi_out {
	mipi_out_panel: endpoint {
		remote-endpoint = <&panel_in_mipi>;
	};
};

&vopb {
	status = "okay";
};

&vopb_mmu {
	status = "okay";
};

&vopl {
	status = "okay";
};

&vopl_mmu {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&tsadc {
	status = "okay";
};

/*
 * I/O voltage domains, from the stock kernel's io_vol_domain nodes. The
 * SDIO WiFi bus runs at 1.8 V; Android's warm reboot kept this setting
 * in the GRF, a full reset does not.
 */
&io_domains {
	status = "okay";

	/* The codec side of I2S and I2C2 runs at 1.8 V */
	audio-supply = <&vcc_18>;
	bb-supply = <&vccio>;
	dvp-supply = <&vcc_18>;
	flash0-supply = <&vcc_18>;
	flash1-supply = <&vccio>;
	gpio1830-supply = <&vccio>;
	gpio30-supply = <&vccio_pmu>;
	lcdc-supply = <&vcc_lcd>;
	sdcard-supply = <&vcc_sd>;
	wifi-supply = <&vcc_wl>;
};

&saradc {
	vref-supply = <&vcc_18>;
	status = "okay";
};

/* Micro-USB port: gadget for the pmOS USB network / debug shell. */
&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	status = "okay";
};

&usb_host1 {
	vbus-supply = <&vcc_host_5v>;
	status = "okay";
};

&wdt {
	status = "okay";
};
