+/*
+ * Scale the input samples by 2^shift with the sensor de-gamma curve, for
+ * sensors wired below the top data line (see rkisp1_config_isp()). The 16
+ * segments of 16 cover 0-255, the input range of an 8-bit sensor read on
+ * the low lines of a 12-bit bus.
+ */
+static void rkisp1_sdg_scale(struct rkisp1_params *params, unsigned int shift)
+{
+	struct rkisp1_cif_isp_sdg_config sdg = { };
+	unsigned int i;
+
+	for (i = 0; i < RKISP1_CIF_ISP_DEGAMMA_CURVE_SIZE; i++) {
+		u16 y = min(i * (16U << shift), 4095U);
+
+		sdg.curve_r.gamma_y[i] = y;
+		sdg.curve_g.gamma_y[i] = y;
+		sdg.curve_b.gamma_y[i] = y;
+	}
+
+	rkisp1_sdg_config(params, &sdg);
+	rkisp1_param_set_bits(params, RKISP1_CIF_ISP_CTRL,
+			      RKISP1_CIF_ISP_CTRL_ISP_GAMMA_IN_ENA);
+}
+
 void rkisp1_params_pre_configure(struct rkisp1_params *params,
 				 enum rkisp1_fmt_raw_pat_type bayer_pat,
 				 enum v4l2_quantization quantization,
@@ -2273,6 +2297,9 @@
 			      rkisp1_hst_params_default_config.mode);
 
 	rkisp1_csm_config(params);
+
