# Reference: <https://postmarketos.org/devicepkg>
maintainer="Tom Barbette <tom.barbette@uclouvain.be>"
pkgname=device-archos-oxygen101
pkgdesc="Archos 101 Oxygen"
pkgver=2
pkgrel=6
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	android-tools
	linux-archos-oxygen101
	postmarketos-base
"
makedepends="devicepkg-dev"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
source="
	deviceinfo
	rockchip-rsce-second.sh
	90-device-archos-oxygen101.rules
	ucm/archos-oxygen101.conf
	ucm/HiFi.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/rockchip-rsce-second.sh \
		"$pkgdir"/usr/share/mkinitfs/rockchip-rsce-second.sh

	# ALSA UCM profile for the RT5640 sound card
	local ucm="$pkgdir"/usr/share/alsa/ucm2
	install -Dm644 -t "$ucm"/Rockchip/archos-oxygen101 \
		"$srcdir"/archos-oxygen101.conf "$srcdir"/HiFi.conf
	mkdir -p "$ucm"/conf.d/simple-card
	ln -s ../../Rockchip/archos-oxygen101/archos-oxygen101.conf \
		"$ucm/conf.d/simple-card/Archos 101 Oxygen.conf"
}

nonfree_firmware() {
	pkgdesc="WiFi firmware"
	depends="firmware-archos-oxygen101 linux-firmware-brcm"
	mkdir "$subpkgdir"
}

