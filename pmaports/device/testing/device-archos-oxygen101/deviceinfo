# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Archos 101 Oxygen"
deviceinfo_manufacturer="Archos"
deviceinfo_codename="archos-oxygen101"
deviceinfo_year="2015"
deviceinfo_dtb="rk3288-archos-oxygen101"
deviceinfo_arch="armv7"

# Device related
deviceinfo_chassis="tablet"
deviceinfo_external_storage="true"
deviceinfo_drm="true"
deviceinfo_screen_width="1920"
deviceinfo_screen_height="1200"
deviceinfo_getty="ttyS2;115200"

# Bootloader related
# Stock Rockchip legacy U-Boot 2014.04. It boots Android boot images from
# the "boot" and "recovery" partitions of its parameter-based partition
# table, ignores the load addresses in the header and loads the device
# tree from a Rockchip resource (RSCE) image in the "second" section,
# which rockchip-rsce-second.sh builds. It also ignores the header command
# line: the kernel carries it (CONFIG_CMDLINE_EXTEND).
# "reboot bootloader" enters its fastboot mode.
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
deviceinfo_bootimg_dtb_second="true"
deviceinfo_mkinitfs_postprocess="/usr/share/mkinitfs/rockchip-rsce-second.sh"
deviceinfo_flash_pagesize="16384"
deviceinfo_flash_offset_base="0x60400000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01c00000"
deviceinfo_flash_offset_second="0x00b00000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_kernel_cmdline="console=ttyS2,115200n8 console=tty0"

# Rockchip Electronics Co., Ltd.
deviceinfo_usb_idVendor="0x2207"
